{
  "name": "marjon-desktop",
  "version": "1.0.6",
  "description": "Marjon POS — desktop terminal for cashiers, waiters and kitchen staff",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "check:css": "node scripts/check-css-classes.mjs",
    "test:payments": "node --test scripts/order-payments.test.mjs",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.17.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "uz.marjon.desktop",
    "productName": "Marjon",
    "copyright": "Copyright © 2025 Marjon",
    "publish": {
      "provider": "github",
      "owner": "Zafarovpolat",
      "repo": "Marjon"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Marjon"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "resources/**/*",
      "!node_modules/lucide-react/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-router-dom/**",
      "!node_modules/axios/**",
      "!node_modules/scheduler/**",
      "!node_modules/@remix-run/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs"
  }
}
