*.egg

# Virtual environments
.venv/
venv/
env/

# Environment files
# .env.production фронтенда — публичный адрес API, без секретов: он должен
# ехать в git, иначе сборка на чистой машине молча зашивает localhost:8000.
.env
.env.local
.env.production
!frontend/.env.production
.marjon-dev.env
.marjon-dev/

# Database
*.db
*.sqlite
*.sqlite3
# Локальные бэкапы dev-базы (dev.db.bak, dev.db.pre-sync.bak и т.п.)
*.db.bak
*.db.*.bak
*.db.bak-*

# Logs
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node
node_modules/
frontend/dist/

# Print agent config (contains tokens)
print_agent/agent_config.json

# Large build artifacts
# Установщики десктопа для страницы /store — 68 МБ бинарники, в git нельзя.
store-files/*.exe

desktop.zip
desktop/build/
mobile/build/
owner/build/
owner.zip

