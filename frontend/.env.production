# Прод-сборка. Файл в git: адреса публичные, секретов тут нет.
# Без него `import.meta.env.VITE_API_URL` падает в дефолт из src/api/client.js
# (http://localhost:8000/api/v1) — в браузере клиента это его собственный
# компьютер, и вход молча ломается.
VITE_API_URL=https://api.marjon.tech/api/v1
# У HQ-админки (src/admin/api.js) своя переменная.
VITE_ADMIN_API_URL=https://api.marjon.tech/api/v1
