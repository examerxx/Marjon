# Copy this file to .marjon-dev.env and replace every CHANGE_ME value.
# .marjon-dev.env is ignored by Git and is the only local secret/config source
# used by start-marjon-dev.ps1.
# The managed backend uses --lifespan off to prevent startup DB mutations.
# start-marjon-dev.ps1 checks canonical RBAC postconditions read-only first.
# Re-audit that gate if canonical app.main.lifespan gains new required work.
DATABASE_URL=postgresql+asyncpg://marjon:CHANGE_ME@db:5432/marjon_authoritative
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_LOCAL_SECRET_AT_LEAST_32_CHARS
DEBUG=true
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
